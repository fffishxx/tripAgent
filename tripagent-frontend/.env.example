# 浏览器请求前缀，默认 /api
VITE_API_BASE_URL=/api
# 开发环境 Vite 代理目标（Java 后端）
VITE_PROXY_TARGET=http://localhost:8080
# 开发端口
VITE_DEV_PORT=5173
# 可选：vite preview 端口
VITE_PREVIEW_PORT=4173

# 高德地图前端 Key（放在本地配置中，不要提交生产密钥）
VITE_AMAP_KEY=
# 高德 JS API 版本
VITE_AMAP_VERSION=2.0
# Web端(JS API) Key 对应的安全密钥；Web服务 Key 可留空
VITE_AMAP_SECURITY_CODE=
