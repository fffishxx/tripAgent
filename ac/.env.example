# 复制为 ac/.env 后填写；真实值不要提交。
# ConfigManager 会在加载 application.yml 前读取同目录 .env。

SERVER_HOST=0.0.0.0
SERVER_PORT=18089
LOG_LEVEL=INFO

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRE_HOURS=720

DB_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

OPENAI_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_TEMPERATURE=0.8
OPENAI_TIMEOUT=30
OPENAI_DISABLE_THINKING=true
OPENAI_STRUCTURED_TIMEOUT=90

PG_POOL_MIN=5
PG_POOL_MAX=10
POSTGRES_URL=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

NACOS_SERVER_ADDR=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_CONFIG_NAMESPACE=public
NACOS_CONFIG_GROUP=DEFAULT_GROUP
NACOS_DISCOVERY_NAME=agent-center
NACOS_DISCOVERY_NAMESPACE=public
# 必须显式设置；不要使用宿主机/容器默认值
NACOS_DISCOVERY_IP=

AMAP_KEY=
AMAP_TIMEOUT=10

TAXI_USE_DIDI=false
DIDI_MCP_KEY=
DIDI_MCP_BASE_URL=https://mcp.didichuxing.com/mcp-servers
DIDI_MCP_SANDBOX_URL=https://mcp.didichuxing.com/mcp-servers-sandbox
DIDI_MCP_SANDBOX=true
DIDI_MCP_TIMEOUT=15

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=development

AGENT_ALLOWED_APP_KEYS=
AUTH_TOKEN_ALLOWED_IPS=

JAVA_BACKEND_BASE_URL=http://127.0.0.1:8080
AGENT_SERVICE_TOKEN=
JAVA_BACKEND_CONNECT_TIMEOUT=3
JAVA_BACKEND_READ_TIMEOUT=10
AGENT_ID=1004
JAVA_BACKEND_MAX_RETRIES=2
