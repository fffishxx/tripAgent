# 复制为 agent-center-gateway/.env 后填写；不要提交 .env
# 这是 Gateway 本地开发配置；Docker/外部部署使用各自的 env / deploy/.env。

# Java ↔ Gateway 内部共享密钥；必须与 Java GATEWAY_INTERNAL_TOKEN 一致
GATEWAY_INTERNAL_TOKEN=

# Gateway 向 Agent /auth/token 换服务 Token 的应用身份
AGENT_APP_KEY=
AGENT_APP_SECRET=
AGENT_AUTH_URL=http://127.0.0.1:18089/auth/token
AGENT_TOKEN_REFRESH_MARGIN=300

# Nacos 服务发现 / shared-logs 配置
NACOS_SERVER_ADDR=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_DISCOVERY_NAMESPACE=
NACOS_DISCOVERY_GROUP=DEFAULT_GROUP
# 必须为外部/Agent 可达的本机 IP；不要留空
NACOS_DISCOVERY_IP=

# Gateway 限流 Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
